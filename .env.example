# Public URL of the deployed site, used in WhatsApp replies and Paystack callbacks.
PUBLIC_SITE_URL=https://equiprent.up.railway.app

# Supabase (server-side only). Leave blank to run on built-in demo data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Without a token, replies are logged instead of sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Shown as "Book on WhatsApp" in the header, digits only e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Ops alerts for new bookings, listings and payments
OPS_WHATSAPP_NUMBER=

# Paystack. Payments settle into our account; owner payouts are released after return.
PAYSTACK_SECRET_KEY=
PAYSTACK_FALLBACK_EMAIL_DOMAIN=renters.equiprent.ng
